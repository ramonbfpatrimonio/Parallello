{
  "name": "parallello",
  "productName": "Parallello",
  "version": "1.0.6",
  "description": "Parallello — reúne Gerar Pré-Venda, Pré-Venda de Ruptura, Acompanhamento de Vendas, Pesquisa de Relatórios e Indicador Logístico num só programa",
  "author": "Ramon Barros Farias",
  "license": "UNLICENSED",
  "private": true,
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "node scripts/build.mjs",
    "start": "node scripts/build.mjs && electron .",
    "test": "node scripts/testes.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "dist": "node scripts/build.mjs && electron-builder --win --publish never",
    "release": "node scripts/build.mjs && electron-builder --win --publish always",
    "rebuild:nativo": "electron-rebuild -f -w msnodesqlv8",
    "instalador": "node scripts/instalador.mjs && electron-builder --config instalador/electron-builder.yml --win --publish never"
  },
  "dependencies": {
    "electron-updater": "6.3.9",
    "pdfjs-dist": "4.10.38"
  },
  "optionalDependencies": {
    "msnodesqlv8": "4.5.0"
  },
  "devDependencies": {
    "@electron/rebuild": "3.7.1",
    "@fontsource/bricolage-grotesque": "^5.1.0",
    "@fontsource/ibm-plex-sans": "^5.1.1",
    "@fontsource/public-sans": "^5.3.0",
    "@supabase/supabase-js": "2.118.0",
    "@types/mssql": "9.1.5",
    "@types/node": "22.10.2",
    "@types/react": "18.3.18",
    "@types/react-dom": "18.3.5",
    "@vitejs/plugin-react": "4.7.0",
    "electron": "36.9.5",
    "electron-builder": "25.1.8",
    "esbuild": "0.24.2",
    "exceljs": "4.4.0",
    "jsdom": "^30.1.3",
    "lucide-react": "0.460.0",
    "mssql": "11.0.2",
    "node-sql-parser": "^5.3.5",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "recharts": "^2.15.4",
    "typescript": "5.6.3",
    "vite": "5.4.21",
    "vitest": "2.1.9"
  }
}
